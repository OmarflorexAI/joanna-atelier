# Contact form delivery (Resend). Copy to .env.local and fill in.
# Without these the form still works in dev and logs to the console.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=joanna@example.com
# Must be a verified sending domain in Resend.
CONTACT_FROM=Atelier <no-reply@joanna.example.com>
